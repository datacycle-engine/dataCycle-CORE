<div class="glass home-container reset-password">
  <div class="home-container-content">
    <div class="columns">
      <%= render 'logo' %>
    </div>

    <main class="columns">
      <h1><%= t('devise.confirmations.new.resend_confirmation_instructions', locale: active_ui_locale) %></h1>

      <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f| %>

        <% if resource.errors.any? %>
          <ul class="errors">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        <% end %>

        <div class="row">
          <div class="small-12 columns">
            <label for="user_email"><%= t('activerecord.attributes.user.email', locale: active_ui_locale) %></label>
            <%= f.email_field :email, required: true, autofocus: true %>
          </div>
        </div>

        <div class="row">
          <div class="small-12 columns">
            <div class="form-actions">
              <%= f.button :button, class: 'button', type: 'submit' do %>
                <%= t('devise.confirmations.new.resend_confirmation_instructions_button', locale: active_ui_locale) %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </main>
  </div>
</div>
