<%= render 'data_cycle_core/contents/viewers/attribute',
      local_assigns.merge(data_attributes: {
        id: (value&.presence&.pluck(:id) || [] ),
        editor: "classification"
      }) do %>
  <span class="detail-content tags">
    <% objects = value&.includes(:concept_path, :concept_scheme).to_a %>
    <% objects = objects.concat(new_relations(options.dig(:item_diff), 'concepts')&.includes(:concept_path, :concept_scheme)) if changes_by_mode(options.dig(:item_diff), '+').present? %>

    <% objects.presence&.each do |a| %>
      <span class="tag <%= changes_class(options.dig(:item_diff), a.id) %>" data-dc-tooltip="<%= concept_tooltip(a) %>">
        <%= a.internal_name %>
      </span>
    <% end %>
  </span>
<% end %>
