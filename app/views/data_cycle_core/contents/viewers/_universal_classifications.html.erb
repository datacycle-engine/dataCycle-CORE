<% objects = value.presence&.includes(:concept_path, :concept_scheme)&.select { |c| c.concept_scheme.visible?('show') } || [] %>

<% if objects.present? %>
  <% objects.group_by(&:concept_scheme).each do |concept_scheme, concepts| %>
    <div data-label="<%= concept_scheme.name %>" class="detail-type classification">
      <span class="detail-label">
        <%= attribute_type_icon(contextual_content(local_assigns), key, definition) %>
        <%= concept_scheme.name %>
      </span>

      <span class="detail-content tags">
        <% concepts.uniq.each do |a| %>
          <%= concept_tag(a) %>
        <% end %>
      </span>
    </div>
  <% end %>
<% end %>
