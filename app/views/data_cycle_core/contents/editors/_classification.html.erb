<%# The pixie's editors are editors of this very attribute -- one per eligible concept scheme that
    shares it -- so they are rendered in its place, where it sorts in the form, instead of being
    appended to the form. This attribute itself renders nothing: it carries no tree_label. %>
<% if annotation_pixie_editors?(**local_assigns) %>
  <% pixie_property_key = key.to_s.attribute_name_from_key %>
  <%= render 'data_cycle_core/contents/editors/features/annotation_pixie',
        content: content,
        property_key: pixie_property_key,
        key_prefix: key.to_s.delete_suffix("[#{pixie_property_key}]") %>
<% end %>

<%= render 'data_cycle_core/contents/editors/attribute', key: key, definition: definition, value: value, options: options, content: content, parent: local_assigns[:parent] do %>

  <%# The annotationPixie's generate button belongs on the label line of the tree it fills, so it is
      rendered into the label itself -- the same slot the table editor's upload button uses. The
      pixie's own editors name their tree in the options, a dedicated classification attribute
      resolves its own; either way the button is the label's last element. %>
  <% if (pixie_property = local_assigns.dig(:options, :annotation_pixie_property) || annotation_pixie_property(**local_assigns)) %>
    <% content_for :additional_label_content, flush: true do %>
      <%= render 'data_cycle_core/contents/editors/features/annotation_pixie_button',
            content: content,
            **pixie_property.slice('concept_scheme_id', 'concept_scheme_name', 'property_key').symbolize_keys %>
    <% end %>
  <% end %>

  <%= attribute_edit_label_tag(**local_assigns) %>

  <div class="v-select">
    <% classification_items = concept_filter_items(definition['tree_label'], { internal_name: :asc }) %>
    <% single_select = definition.dig('ui', 'edit', 'options', 'multiple') == false || definition.dig('validations', 'max') == 1 %>
    <%= hidden_field_tag "#{key}[]", nil %>

    <% if (definition.dig('ui', 'edit', 'async').to_s != 'false' && classification_items.size > DataCycleCore.max_asynch_classification_items) %>
      <%= select_tag(
            "#{key}[]",
            async_concept_select_options(value),
            classification_select_config(key, definition, options, content, { class: 'async-select' })
          ) %>
    <% else %>
      <%= select_tag(
            "#{key}[]",
            simple_concept_select_options(value, classification_items),
            classification_select_config(key, definition, options, content)
          ) %>
    <% end %>

    <% value.presence&.each do |c| %>
      <%= hidden_field_tag "#{key}[]", c.id %>
    <% end unless attribute_editable?(key, definition, options, content) %>
  </div>
<% end if concept_scheme_has_concepts?(definition['tree_label']) %>
