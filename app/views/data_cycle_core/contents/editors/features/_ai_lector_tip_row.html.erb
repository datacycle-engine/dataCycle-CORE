<% identifier = SecureRandom.hex(10) %>

<li class="ai-lector-row <%= category %>">
  <button
    type="button"
    id="<%= identifier %>"
    class="ai-lector-button ai-lector-tip-button"
    data-template-name="<%= content.template_name %>"
    data-content-id="<%= content.id %>"
    data-tip-key="<%= k %>"
    data-key="<%= key %>"
    data-prompt-type="tips"
    data-locale="<%= I18n.locale %>"
  >
    <i class="fa <%= icon %> ai-lector-button-icon" aria-hidden="true"></i>
    <span class="ai-lector-button-label"><%= t("feature.ai_lector.tips.#{k}", default: k, locale: active_ui_locale) %></span>
  </button>

  <div class="ai-lector-result">
    <button class="close-button ai-lector-close-result" aria-label="Close results" type="button">
      <span aria-hidden="true">&times;</span>
    </button>

    <div class="ai-lector-result-content ellipsis-loading">
      <%= t('feature.ai_lector.diff.thinking', locale: active_ui_locale) %>
    </div>
  </div>
</li>
