<div class="tags">
  <ul class="no-bullet no-format">
    <% object.display_concepts(local_assigns[:concept_scheme_visibility] || 'compact').each do |concept| %>
      <%= tag.li(
        concept.internal_name,
        style: concept_color_style(concept),
        class: "tag #{'mapped' unless object.concepts.include?(concept)} #{concept_path_classes(concept)}",
        data: {
          dc_tooltip: concept_tooltip(concept)
        }
      ) %>
    <% end %>
  </ul>
</div>
