<?xml version="1.0" encoding="utf-8"?>

<rdf:RDF
  xmlns:rdf="https://schema.org/"
  xmlns:schema="https://schema.org/Thing/">

  <classificationTree
    about="<%= root_url(mode: 'tree', ctl_id: @concept_scheme.id, reset: true) %>">
    <id><%=@concept_scheme.id%></id>
    <name><%=@concept_scheme.name%></name>
    <url><%=xml_v1_classification_tree_url(@concept_scheme, language: @language, api_subversion: @api_subversion)%></url>
  </classificationTree>
</rdf:RDF>
