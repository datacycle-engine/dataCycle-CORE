
<<%=key%>>
<% concepts&.each do |concept| %>
  <classification>
    <id><%=concept.id%></id>
    <name><%=concept.name(locale: @language) || concept.try(:internal_name)%></name>
    <% if concept.description(locale: @language).present? %>
      <description><%=concept.description(locale: @language)%></description>
    <% end %>
    <% unless @mode_parameters.include?('minimal') %>
      <anchestor>
        <% concept.ancestors_with_concept_scheme.each do |ancestor| %>
          <classification>
            <id><%=ancestor.id%></id>
            <name><%=ancestor.is_a?(DataCycleCore::ConceptScheme) ? ancestor.name : ancestor.name(locale: @language) || ancestor.try(:internal_name)%></name>
          </classification>
        <% end %>
      </anchestor>
    <% end %>
  </classification>
<% end %>
</<%=key%>>
