<% unless @mode_parameters.include?('compact') %>
  <% concepts = content.send(key) %>
  <% if concepts.present? && definition.dig('xml', 'disabled').blank? %>
    <% key_new = definition.dig('xml', 'name') || key.camelize(:lower) %>
    <% if definition.dig('xml', 'transformation', 'method') == 'serialize' && definition.dig('xml', 'transformation', 'name') == 'string' %>
      <<%=key_new%>>
      <% concepts.each do |concept| %>
        <type><%=definition.dig('xml', 'type') || 'Enumeration'%></type>
        <name><%=normalize_string(concept.name).html_safe%></name>
      <% end %>
      </<%=key_new%>>
    <% else %>
      <%= render render_partial('classifications'), concepts: concepts, key: key_new, definition: definition, cache: true %>
    <% end %>
  <% end %>
<% end %>
