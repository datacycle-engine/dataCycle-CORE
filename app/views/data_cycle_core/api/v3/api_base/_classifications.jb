# frozen_string_literal: true

classifications = concepts&.map do |item|
  {
    id: item.id,
    name: item.name(locale: @language) || item.internal_name,
    description: item.description(locale: @language),
    uri: item.uri,
    createdAt: item.created_at,
    updatedAt: item.updated_at,
    deletedAt: item.try(:deleted_at),
    ancestors: item.ancestors_with_concept_scheme.map do |ancestor|
      {
        id: ancestor.id,
        name: ancestor.is_a?(DataCycleCore::ConceptScheme) ? ancestor.name : ancestor.name(locale: @language) || ancestor.try(:internal_name),
        createdAt: ancestor.created_at,
        updatedAt: ancestor.updated_at,
        deletedAt: ancestor.try(:deleted_at)
      }.compact
    end
  }.compact.deep_stringify_keys
end

{
  key.to_s => classifications
}
