# frozen_string_literal: true

json ||= {}

unless @mode_parameters.include?('compact')
  concepts = content.send(key)
  if concepts.present?
    key_new = definition.dig('api', 'name') || key.camelize(:lower)
    if definition.dig('api', 'transformation', 'method') == 'serialize' && definition.dig('api', 'transformation', 'name') == 'string'
      json[key_new] = concepts.map do |concept|
        {
          '@type' => definition.dig('api', 'type') || 'Enumeration',
          'name' => concept.description || concept.name || concepts.internal_name
        }
      end
    else
      json.merge! render 'classifications', concepts:, key: key_new, definition:
    end
  end
end

json
