# frozen_string_literal: true

json = {}
concepts = content.send(key)

key_new = definition.dig('api', 'name') || key.camelize(:lower)

if concepts.present?
  json[key_new] = concepts.map { |concept|
    case concept.internal_name
    when 'Januar'
      1
    when 'Februar'
      2
    when 'März'
      3
    when 'April'
      4
    when 'Mai'
      5
    when 'Juni'
      6
    when 'Juli'
      7
    when 'August'
      8
    when 'September'
      9
    when 'Oktober'
      10
    when 'November'
      11
    when 'Dezember'
      12
    else
      concept.name
    end
  }&.sort
end

json
