# frozen_string_literal: true

json ||= {}

json.merge! render 'classifications', concepts: @concepts, key: 'data'

json.merge! render 'pagination_links',
                   objects: @concepts,
                   object_url: ->(params) { classifications_api_v3_classification_tree_url(@api_subversion, @concept_scheme, params.merge(classification_id: @classification_id)) }

json
