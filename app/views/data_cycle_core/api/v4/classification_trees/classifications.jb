# frozen_string_literal: true

def load_classification_data(language, options)
  Rails.cache.fetch(api_v4_cache_key(@concepts.first, language, options[:include], options[:fields], @api_subversion, nil), expires_in: 1.year + Random.rand(7.days)) do
    I18n.with_locale(language) do
      render('classification', content: @concepts.first, options: options.dup)
    end
  end
end

default_options = {
  include: @include_parameters,
  fields: @fields_parameters,
  field_filter: @field_filter,
  languages: @language
}
options = default_options.merge(defined?(options) ? options || {} : {})
options[:languages] = Array(I18n.locale.to_s) if options[:languages].blank?

json ||= {}

if @concept_scheme.present?
  json.merge! render 'context', languages: options[:languages]

  if @classification_id.present?
    unless @permitted_params.dig(:section, :@graph)&.to_i&.zero?
      concept = @concepts.first
      json['@graph'] = []
      unless concept.nil?
        json['@graph'] << Rails.cache.fetch(api_v4_cache_key(concept, options[:languages], options[:include], options[:fields], @api_subversion, nil), expires_in: 1.year + Random.rand(7.days)) do
          I18n.with_locale(concept.first_available_locale(options[:languages])) do
            render 'classification', content: concept, options: options.dup
          end
        end
      end
    end
  else
    @concepts.async_total_count unless @permitted_params.dig(:section, :meta)&.to_i&.zero?

    json.merge! render 'classifications', concepts: @concepts, key: '@graph', options:, show_all_concepts: true unless @permitted_params.dig(:section, :@graph)&.to_i&.zero?

    json.merge! render 'pagination_links',
                       objects: @concepts,
                       object_url: ->(params) { classifications_api_v4_concept_scheme_url(@api_subversion, @concept_scheme, params.merge(classification_id: @classification_id)) }

  end
end

json
