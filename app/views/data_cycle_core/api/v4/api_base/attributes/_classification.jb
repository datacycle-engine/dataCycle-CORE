# frozen_string_literal: true

json ||= {}
key_new = attribute_key(key, definition)
json[key_new] ||= []

api_property_definition = api_definition(definition)
concepts = load_value_object(content, key, value, options[:languages], api_property_definition, options[:expand_language])

json.merge! render 'classifications', concepts:, key: key_new, definition: {}, options: options.dup
json.compact_blank
