# frozen_string_literal: true

json ||= {}
key_new = attribute_key(key, definition)
api_property_definition = api_definition(definition)

concepts = content.send(:"#{key}_overlay")
enumerations = concepts.presence.map do |concept|
  {
    '@type' => api_property_definition['type'] || 'Enumeration',
    'name' => concept.uri || concept.name || concept.internal_name
  }
end

json = { key_new => enumerations } if enumerations.present?
json
