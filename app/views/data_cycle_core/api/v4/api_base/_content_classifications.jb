# frozen_string_literal: true

json ||= {}
json['dc:classification'] ||= []

concepts = content.full_concepts.reorder(nil).order('"concept_schemes"."name" ASC, "concepts"."order_a" ASC').includes(:concept_scheme).references(:concept_scheme)
concepts = concepts.merge(DataCycleCore::ConceptScheme.visible('api'))
concepts = concepts.merge(DataCycleCore::ConceptScheme.where(id: options[:classification_trees])) if options[:classification_trees_filter]

json.merge! render 'classifications', concepts:, key:, definition: {}, options: options.dup
json.compact_blank
