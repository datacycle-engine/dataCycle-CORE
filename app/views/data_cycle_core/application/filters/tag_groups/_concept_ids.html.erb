<span class="tag-group tags <%= key %> <%= local_assigns[:filter_method] || 'i' %> <%= local_assigns[:container_classes] %>" data-id="<%= target %>">
  <span class="tag-group-label">
    <%= render 'data_cycle_core/shared/icon', icon_type: title&.underscore_blanks, icon_class: 'classification_tree_label' %>
    <span><%= t("filter.#{key}", default: title, locale: active_ui_locale) %></span>
  </span>

  <% concepts ||= DataCycleCore::Concept.includes(:concept_path)
    .where(id: value)
    .map { |c| [c.id, c] }.to_h %>

  <span class="tags-container">
    <% if buttons == 'd' %>
      <% value.each do |ca_id| %>
        <label for="<%= target %>_<%= ca_id %>">
          <a class="tag" data-dc-tooltip="<%= concept_tooltip(concepts[ca_id]) %>">
            <%= I18n.with_locale(concepts[ca_id]&.first_available_locale(active_ui_locale)){ concept_title(concepts[ca_id]) } %><i class="fa fa-times" aria-hidden="true"></i>
          </a>
        </label>
      <% end %>
    <% else %>
      <% value.each do |ca_id| %>
        <span class="tag" data-dc-tooltip="<%= concept_tooltip(concepts[ca_id]) %>"><%= concept_title(concepts[ca_id]) %></span>
      <% end %>
    <% end %>
  </span>

  <%= render 'data_cycle_core/application/filters/tag_groups/advanced_buttons', local_assigns if buttons %>
</span>
