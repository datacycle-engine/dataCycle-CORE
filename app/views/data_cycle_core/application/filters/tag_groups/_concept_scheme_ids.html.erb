<span class="tag-group tags <%= key %> <%= local_assigns[:filter_method] || 'i' %> <%= local_assigns[:container_classes] %>" data-id="<%= target %>">
  <span class="tag-group-label">
    <i class="fa fa-sitemap" aria-hidden="true"></i>
    <span><%= t("filter.#{key}", default: title, locale: active_ui_locale) %></span>
  </span>

  <% concept_schemes ||= DataCycleCore::ConceptScheme
    .where(id: value)
    .map { |c| [c.id, c] }.to_h %>

  <span class="tags-container">
    <% if buttons == 'd' %>
      <% value.each do |cs_id| %>
        <label for="<%= cs_id %>">
          <a class="tag">
            <%= concept_schemes[cs_id].try(:name) %><i class="fa fa-times" aria-hidden="true"></i>
          </a>
        </label>
      <% end %>
    <% else %>
      <% value.each do |cs_id| %>
        <span class="tag"><%= concept_schemes[cs_id].try(:name) %></span>
      <% end %>
    <% end %>
  </span>

  <%= render 'data_cycle_core/application/filters/tag_groups/advanced_buttons', local_assigns if buttons %>
</span>
