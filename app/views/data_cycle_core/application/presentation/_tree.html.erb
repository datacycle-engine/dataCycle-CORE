<% if @external_system_tree %>
  <li id="<%= DataCycleCore::FilterConcern::EXTERNAL_SYSTEM_TREE_ID %>">
    <h5><%= t('tree_view.external_systems', locale: active_ui_locale, default: 'Externe Systeme') %></h5>
    <ul class="children">
      <%= render partial: 'data_cycle_core/contents/tree/external_system', collection: @external_systems %>
    </ul>
  </li>
<% else %>
  <li id="<%= @classification_tree_label.id %>">
    <h5><%= t("tree_view.#{@classification_tree_label.name}", locale: active_ui_locale, default: @classification_tree_label.name) %></h5>
    <ul class="children">
      <%= render 'data_cycle_core/contents/tree/classification_trees',
        classification_tree_label: @classification_tree_label,
        classification_trees: @classification_trees %>
    </ul>
  </li>
<% end %>
