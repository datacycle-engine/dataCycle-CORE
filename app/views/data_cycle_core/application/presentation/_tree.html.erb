<% if @external_system_tree %>
  <li id="<%= DataCycleCore::FilterConcern::EXTERNAL_SYSTEM_TREE_ID %>">
    <h5><%= t('tree_view.external_systems', locale: active_ui_locale, default: 'Externe Systeme') %></h5>
    <ul class="children">
      <%= render partial: 'data_cycle_core/contents/tree/external_system', collection: @external_systems %>
    </ul>
  </li>
<% else %>
  <li id="<%= @concept_scheme.id %>">
    <h5><%= t("tree_view.#{@concept_scheme.name}", locale: active_ui_locale, default: @concept_scheme.name) %></h5>
    <ul class="children">
      <%= render 'data_cycle_core/contents/tree/concepts',
        concept_scheme: @concept_scheme,
        concepts: @concepts %>
    </ul>
  </li>
<% end %>
