<% inverted = local_assigns[:inverted] %>
<span class="logo<%= ' has-inverted-logo' if DataCycleCore.logo['inverted'].present? %>">
  <%= image_tag dc_image_path(dc_logo_file(inverted:)), alt: DataCycleCore.logo['alt_text'], class: 'hide-for-print logo-screen-default' %>
  <% if !inverted && DataCycleCore.logo['inverted'].present? %>
    <%= image_tag dc_image_path(DataCycleCore.logo['inverted']), alt: DataCycleCore.logo['alt_text'], class: 'hide-for-print logo-screen-inverted' %>
  <% end %>
  <%= image_tag dc_image_path(dc_print_logo_file(inverted:)), alt: DataCycleCore.logo['alt_text'], class: 'show-for-print' %>
</span>
