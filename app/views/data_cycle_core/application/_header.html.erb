<header>
  <div class="top-bar">
    <div class="top-bar-title">
      <%= link_to_condition can?(:index, :backend), root_path do %>
        <%= render 'logo', inverted: true %>
        <%= header_title %>
        <%= yield :menu_title %>
      <% end %>
    </div>
    <div class="top-bar-right" id="main-menu">
      <ul class="menu">
        <li>
          <% if can?(:read, DataCycleCore::WatchList) %>
            <%= render 'watch_lists' %>
          <% end %>
        </li>
        <% if user_signed_in? %>
          <li>
            <button type="button" class="button show-sidebar" data-toggle="settings-off-canvas" data-dc-tooltip="<%= current_user.email %>">
              <span class="user-initials" aria-hidden="true"><%= current_user.initials %></span>
              <span><%= current_user.full_name_or_email %></span>
              <i class="fa fa-bars icon-right" aria-hidden="true"></i>
            </button>
          </li>
        <% else %>
          <li>
            <%= link_to data_cycle_core.new_user_session_path do %>
              <span>Login</span>
              <i class="fa fa-sign-in icon-right" aria-hidden="true"></i>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</header>
