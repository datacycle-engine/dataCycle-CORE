<% if @object.is_a?(DataCycleCore::ConceptScheme) %>
  <%= render 'data_cycle_core/classifications/concept_scheme', concept_scheme: @object %>

  <%= render 'data_cycle_core/classifications/new_concept_scheme' %>
<% else %>
  <%= render 'data_cycle_core/classifications/concept', concept_scheme: @concept_scheme, concept: @object, ancestors: @object.ancestors.pluck(:id).reverse, type: 'direct' %>

  <%= render 'data_cycle_core/classifications/new_concept', concept_scheme: @concept_scheme, parent_concept: @parent_concept %>
<% end %>
