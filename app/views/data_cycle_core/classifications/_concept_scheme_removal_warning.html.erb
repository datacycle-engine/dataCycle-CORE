<p><%= t('actions.delete_confirmation_html', type: concept_scheme.model_name.human(locale: active_ui_locale), name: concept_scheme.name, locale: active_ui_locale) %></p>

<% if concept_scheme.things.exists? %>
  <div class='warning callout'>
    <%= t('data_cycle_core.classification_tree_relations', locale: active_ui_locale) %>
  </div>
<% end %>

<% if concept_scheme.concepts.exists? %>
  <div class='warning callout'>
    <%= t('data_cycle_core.child_classification_relations_html',
          count: concept_scheme.concepts.size,
          data: t('data_cycle_core.this_classification_tree', locale: active_ui_locale),
          locale: active_ui_locale) %>
  </div>
<% end %>

<% usage = DataCycleCore::StoredFilter.used_by_classification(concept_scheme.id) %>
<% if usage.present? %>
  <% direct_count = usage.count { |_, direct| direct } %>
  <div class='warning callout'>
    <%= t('classification_administration.stored_filter_usage.removal_warning_html',
          count: usage.size, direct: direct_count, indirect: usage.size - direct_count,
          data: t('data_cycle_core.this_classification_tree_nominative', locale: active_ui_locale),
          locale: active_ui_locale) %>
  </div>
<% end %>
