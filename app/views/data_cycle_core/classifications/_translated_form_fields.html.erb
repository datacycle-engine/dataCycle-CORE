<% I18n.with_locale(locale) do %>
  <%= label_tag "concept[translation][#{locale}][name]", "#{DataCycleCore::Concept.human_attribute_name(:name, locale: active_ui_locale)} (#{locale})", class: 'ca-label' %>
  <%= text_field_tag "concept[translation][#{locale}][name]", concept&.name, class: 'ca-input-field', disabled: concept&.id.present? ? !can?(:update, concept) : !can?(:create, DataCycleCore::Concept) %>

  <div class="form-element">
    <div class="editor-block">
      <%= label_tag "concept[translation][#{locale}][description]", "#{DataCycleCore::Concept.human_attribute_name(:description, locale: active_ui_locale)} (#{locale})" %>
      <%= hidden_field_tag "concept[translation][#{locale}][description]", concept&.description, id: (concept&.id.present? ? "#{concept&.id}_" : '') + "concept_#{locale}_description" %>

      <div class="quill-editor" data-hidden-field-id="<%= "#{concept&.id}_" if concept&.id.present? %>concept_<%= locale %>_description" data-size="minimal" data-default-value="<%= concept&.description %>">
        <%= concept&.description&.html_safe %>
      </div>
    </div>
  </div>
<% end %>
