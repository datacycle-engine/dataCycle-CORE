<p><%= t('actions.delete_confirmation_html', type: concept.model_name.human(locale: active_ui_locale), name: concept.full_path, locale: active_ui_locale) %></p>

<% if concept.linked_contents.exists? %>
  <div class="warning callout">
    <%= t('data_cycle_core.classification_relations_html', count: concept.linked_contents.size, locale: active_ui_locale) %>
  </div>
<% end %>

<% if concept.children.exists? %>
  <div class="warning callout">
    <%= t('data_cycle_core.child_classification_relations_html', count: concept.children.size, data: t('data_cycle_core.this_classification', locale: active_ui_locale), locale: active_ui_locale) %>
  </div>
<% end %>

<% usage = DataCycleCore::StoredFilter.used_by_classification(concept.id) %>
<% if usage.present? %>
  <% direct_count = usage.count { |_, direct| direct } %>
  <div class="warning callout">
    <%= t('classification_administration.stored_filter_usage.removal_warning_html',
          count: usage.size, direct: direct_count, indirect: usage.size - direct_count,
          data: t('data_cycle_core.this_classification_nominative', locale: active_ui_locale),
          locale: active_ui_locale) %>
  </div>
<% end %>
