<% if @mapped_view %>
  <%= render('mapped_concepts', concept_scheme: @concept_scheme, mapped_concepts: @concepts, type: 'direct') if @type != 'mapped' %>
<% else %>
  <%= render('concepts', concept_scheme: @concept_scheme, parent_concept: @concept, concepts: @concepts, type: 'direct') if @type != 'mapped' %>
<% end %>

<%= render('mapped_concepts', concept_scheme: @concept_scheme, mapped_concepts: @mapped_concepts, type: 'mapped') if @type != 'direct' %>
