<% breadcrumb :classifications, autoroot: false %>

<div id="classification-administration" class="row">
  <div class="small-12 columns">
    <h1><%= t('data_cycle_core.classifications', locale: active_ui_locale) %></h1>

    <% grouped_concept_schemes(@concept_schemes).each do |group_key, concept_schemes| %>
      <%= tag.h4(group_key) if group_key.present? %>

      <ul class="classification_trees backend-treeview-list">
        <%= render partial: 'concept_scheme', collection: concept_schemes, as: :concept_scheme %>

        <% if !group_key && can?(:create, DataCycleCore::ConceptScheme) %>
          <%= render 'data_cycle_core/classifications/new_concept_scheme' %>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
